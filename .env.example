# Copy to .env in the repo root and fill in. .env is gitignored; this example
# is committed. Every hed-* command loads .env from the directory it is run
# from, so run the commands from the repo root.

# GitHub personal access token. Needed by the networked hed-* commands; without
# it they still run but are rate-limited to 60 requests an hour. Needs no
# scopes for public repositories.
GITHUB_TOKEN=

# Where cached API responses are written. Set this to the one directory shared
# by every HED metadata repo on the machine, so a lookup done in one repo is
# not repeated in another. Resolution order is --cache-dir, then this variable,
# then outputs/cache/ under the directory the command runs in.
HED_CACHE_DIR=
